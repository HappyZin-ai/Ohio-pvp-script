    updateAmmoButton()
end)

local AmmoKeywords = {
    "ammo",
    "ammunition",
    "clip",
    "magazine",
    "mag",
    "bullet",
    "bullets",
    "round",
    "rounds",
    "shot",
    "shots",
    "reserve",
    "remaining"
}

local function normalizeName(name)
    return string.lower(
        tostring(name)
            :gsub("[%s_%-%./]", "")
    )
end

local function looksLikeAmmoName(name)
    local normalized =
        normalizeName(name)

    for _, keyword in ipairs(
        AmmoKeywords
    ) do
        if string.find(
            normalized,
            keyword,
            1,
            true
        ) then
            return true
        end
    end

    return false
end

local function setInfiniteValue(object)
    if object:IsA("IntValue")
        or object:IsA("NumberValue") then

        if object.Value < 999 then
            object.Value = 999
        end

        return true
    end

    return false
end

local function scanAttributes(instance)
    for attributeName, value in pairs(
        instance:GetAttributes()
    ) do

        if typeof(value) == "number"
            and looksLikeAmmoName(attributeName) then

            if value < 999 then
                instance:SetAttribute(
                    attributeName,
                    999
                )
            end
        end
    end
end

local function scanTool(tool)
    if not tool:IsA("Tool") then
        return
    end

    scanAttributes(tool)

    if looksLikeAmmoName(tool.Name) then
        setInfiniteValue(tool)
    end

    for _, object in ipairs(
        tool:GetDescendants()
    ) do

        if looksLikeAmmoName(object.Name) then
            setInfiniteValue(object)
        end

        scanAttributes(object)
    end
end

local function scanContainer(container)
    if not container then
        return
    end

    for _, object in ipairs(
        container:GetChildren()
    ) do

        if object:IsA("Tool") then
            scanTool(object)
        end
    end
end

local function updateInfiniteAmmo()
    if not Settings.InfiniteAmmo then
        return
    end

    local character =
        LocalPlayer.Character

    if character then
        scanContainer(character)
    end

    local backpack =
        LocalPlayer:FindFirstChildOfClass(
            "Backpack"
        )

    if backpack then
        scanContainer(backpack)
    end
end

local function connectAmmoContainer(container)
    if not container then
        return
    end

    container.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            task.defer(function()
                if Settings.InfiniteAmmo then
                    scanTool(child)
                end
            end)
        end
    end)
end

connectAmmoContainer(
    LocalPlayer:FindFirstChildOfClass(
        "Backpack"
    )
)

