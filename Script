local function getBlinkPosition()
    local character =
        LocalPlayer.Character

    if not character then
        return nil
    end

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return nil
    end

    local camera =
        workspace.CurrentCamera

    if not camera then
        return nil
    end

    local direction =
        camera.CFrame.LookVector

    local params =
        RaycastParams.new()

    params.FilterType =
        Enum.RaycastFilterType.Exclude

    params.FilterDescendantsInstances = {
        character
    }

    local result =
        workspace:Raycast(
            root.Position,
            direction *
                Settings.BlinkDistance,
            params
        )

    local distance =
        Settings.BlinkDistance

    if result then
        distance = math.max(
            0,
            (
                result.Position -
                root.Position
            ).Magnitude - 3
        )
    end

    if distance <= 0 then
        return root.Position
    end

    return root.Position +
        direction * distance
end

local function updateBlinkMarker()
    if not Settings.BlinkEnabled then
        BlinkMarker.Transparency = 1
        return
    end

    local position =
        getBlinkPosition()

    if not position then
        BlinkMarker.Transparency = 1
        return
    end

    BlinkMarker.Position = position
    BlinkMarker.Transparency = 0.25
end

local function blink()
    if not Settings.BlinkEnabled then
        return
    end

    if os.clock() - lastBlink <
        Settings.BlinkCooldown then

        return
    end

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return
    end

    local position =
        getBlinkPosition()

    if not position then
        return
    end

    root.CFrame =
        CFrame.new(
            position,
            position +
                workspace.CurrentCamera.CFrame.LookVector
        )

    lastBlink = os.clock()
end

