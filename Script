--==================================================

local minimized = false
local closed = false

local function setMinimized(state)
    minimized = state

    if state then
        RestoreBar.Position = Main.Position
        Main.Visible = false
        RestoreBar.Visible = true
    else
        Main.Visible = true
        RestoreBar.Visible = false
    end
end

local function setClosed(state)
    closed = state

    if state then
        Main.Visible = false
        RestoreBar.Visible = false
    else
        Main.Visible = true
        RestoreBar.Visible = false
    end
end

