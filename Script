local ESPObjects = {}

local function removeESP(player)
    local object =
        ESPObjects[player]

    if object then

        if object.Line then
            object.Line:Destroy()
        end

        if object.NameTag then
            object.NameTag:Destroy()
        end

        if object.Highlight then
            object.Highlight:Destroy()
        end

        ESPObjects[player] = nil
    end
end

local function createESP(player)
    if player == LocalPlayer then
        return
    end

    if ESPObjects[player] then
        return
    end

    local line =
        Instance.new("Frame")

    line.Name =
        player.Name .. "_Line"

    line.AnchorPoint =
        Vector2.new(0.5, 0.5)

    line.BorderSizePixel = 0

    line.BackgroundColor3 =
        Settings.ESPColor

    line.Size =
        UDim2.fromOffset(
            0,
            Settings.ESPThickness
        )

    line.Visible = false
    line.ZIndex = 10
    line.Parent = ESPFolder

    local nameTag =
        Instance.new("TextLabel")

    nameTag.Name =
        player.Name .. "_Nickname"

    nameTag.AnchorPoint =
        Vector2.new(0.5, 1)

    nameTag.BackgroundTransparency = 1

    nameTag.TextColor3 =
        Color3.fromRGB(255, 255, 255)

    nameTag.TextStrokeTransparency = 0

    nameTag.TextSize = 12

    nameTag.Font =
